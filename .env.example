# ─────────────────────────────────────────────────────────────
# 2211 BEATS — environment configuration
# Copy to .env.local and fill in. Everything has a working
# default, so the site runs out of the box in "demo mode".
# ─────────────────────────────────────────────────────────────

# Public base URL of the site (used in emails + payment callbacks)
APP_URL=http://localhost:3000
APP_NAME=2211 BEATS

# Brand accent colour (hex) — themes buttons, hero glow, navbar and emails.
# Can be changed later from Admin → Settings → Accent colour.
ACCENT_COLOR=#e10600

# Secret used to sign session cookies + download links. CHANGE THIS.
APP_SECRET=change-me-to-a-long-random-string

# ── Database ────────────────────────────────────────────────
# Leave empty  -> local SQLite file at storage/app.db (zero setup, dev/preview)
# Set a URL    -> PostgreSQL (production): postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ── Seeded admin account (created on first run) ─────────────
ADMIN_EMAIL=admin@2211beats.com
ADMIN_NAME=2211 Producer
ADMIN_PASSWORD=Admin!2211
ADMIN_PHONE=+233200000000

# Default listing currency (GHS, NGN, KES, USD ...)
CURRENCY=GHS

# ── Email (SMTP) ────────────────────────────────────────────
# Leave SMTP_HOST empty -> emails are stored in the in-app outbox
# (/admin/emails) and written to storage/outbox so you can read them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="2211 BEATS <hello@2211beats.com>"
MAIL_REPLY_TO=
# Where to forward contact-form + order notifications
ADMIN_MAIL=admin@2211beats.com

# ── Paystack (Ghana/Nigeria: MTN MoMo, Telecel Cash, cards, bank) ─
# Get keys at https://dashboard.paystack.co/#/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_URL=

# ── M-Pesa / Safaricom Daraja (Kenya STK Push) ──────────────
# Get keys at https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ── Bank transfer details (shown at checkout) ───────────────
BANK_ENABLED=true
BANK_NAME=Ecobank Ghana
BANK_ACCOUNT_NAME=2211 Beats Ltd
BANK_ACCOUNT_NUMBER=1441000221199
BANK_BRANCH=Accra Central
BANK_SWIFT=ECOCGHAC
BANK_MOBILE_MONEY_NAME=MTN MoMo
BANK_MOBILE_MONEY_NUMBER=+233 20 000 0000
BANK_INSTRUCTIONS=Send the exact amount, then enter the transaction reference below so we can match your payment.

# ── WhatsApp — producer gets booking/order alerts on website + WhatsApp ──
# When an order is created, bank transfer submitted, paid, or contact form sent,
# the producer gets an inbound message in /admin/messages and a WhatsApp.
# Supports multiple providers — pick one:
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=auto
# auto = detects from keys below. Or set explicitly: meta, twilio, ultramsg, webhook, none
WHATSAPP_TO=+233200000000
# Override producer number (otherwise uses site_settings whatsapp / contact_phone / ADMIN_PHONE)

# Meta WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
# Get token and phone number ID from Meta dashboard
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio WhatsApp (https://www.twilio.com/docs/whatsapp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# UltraMsg (https://ultramsg.com) — simple HTTP WhatsApp gateway
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# Generic webhook — POSTs {to, message} JSON to your n8n / Zapier / Make / custom endpoint
# You can build a WhatsApp sender there and still get website inbox messages
WHATSAPP_WEBHOOK_URL=
# For Meta webhook verification (GET hub.verify_token)
WHATSAPP_VERIFY_TOKEN=2211-verify
META_VERIFY_TOKEN=2211-verify

# ── Storage ─────────────────────────────────────────────────
UPLOAD_DIR=storage/uploads

# ── Bulk import ─────────────────────────────────────────────
# Folder scanned by /admin/import. Drop beats in (one folder each, or flat files
# named "Genre - Title (120 BPM) (A min) - master.wav") plus optional beat.json
# or manifest.json, then publish them from the producer console.
IMPORT_DIR=storage/import
MAX_UPLOAD_MB=400
