{
  "name": "2211-beats",
  "version": "1.0.0",
  "private": true,
  "description": "Beat store for a music producer. Admin uploads beats & videos, artists create accounts, pay with M-Pesa / Paystack / bank transfer, and receive their beats and messages by email.",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning ./node_modules/next/dist/bin/next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "node --disable-warning=ExperimentalWarning ./node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3000",
    "setup": "node scripts/setup.mjs",
    "db:reset": "node scripts/setup.mjs --reset",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "next": "15.5.27",
    "nodemailer": "7.0.5",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/nodemailer": "7.0.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
